#version 460

/**
 * @file gs_tile_range.comp
 * @brief Builds per-tile entry ranges from tile-id sorted entries.
 *
 * Input entries are sorted by tile id, with depth order preserved within each
 * tile by the previous stable sort. Each invocation detects run boundaries and
 * writes tile_offsets[] / tile_counts[] for the corresponding tile.
 */

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform PC {
    uint max_entry_count;
    uint tile_count;
} pc;

layout(set = 3, binding = 0) readonly buffer SortedTileIdBuffer {
    uint sorted_tile_ids[];
};

layout(set = 3, binding = 1) readonly buffer EntryCountBuffer {
    uint entry_count;
};

layout(set = 3, binding = 2) writeonly buffer TileOffsetBuffer {
    uint tile_offsets[];
};

layout(set = 3, binding = 3) writeonly buffer TileCountBuffer {
    uint tile_counts[];
};

layout(set = 3, binding = 4) buffer EntryStatsBuffer {
    uint stats_visible_splats;
    uint entry_requested_count;
    uint entry_written_count;
    uint entry_dropped_count;
    uint invalid_entry_count;
    uint sort_clamped;
};

void main() {
    const uint sorted_index = gl_GlobalInvocationID.x;
    const uint active_count = min(entry_count, pc.max_entry_count);
    if (sorted_index >= active_count) {
        return;
    }

    const uint tile_id = sorted_tile_ids[sorted_index];
    if (tile_id >= pc.tile_count) {
        atomicAdd(invalid_entry_count, 1u);
        return;
    }

    const bool is_run_begin = sorted_index == 0u || sorted_tile_ids[sorted_index - 1u] != tile_id;
    const bool is_run_end = sorted_index + 1u >= active_count || sorted_tile_ids[sorted_index + 1u] != tile_id;

    if (is_run_begin) {
        tile_offsets[tile_id] = sorted_index;
    }

    if (is_run_end) {
        uint run_begin = sorted_index;
        while (run_begin > 0u && sorted_tile_ids[run_begin - 1u] == tile_id) {
            --run_begin;
        }
        tile_counts[tile_id] = sorted_index + 1u - run_begin;
    }
}
