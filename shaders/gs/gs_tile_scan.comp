#version 460

/**
 * @file gs_tile_scan.comp
 * @brief Prefix scan for Gaussian Splatting tile counters.
 *
 * Converts per-tile splat counts into exclusive per-tile offsets. The shader is
 * intentionally separate from the radix sort histogram scan because tile counts
 * are a single linear array rather than a digit-major histogram table.
 *
 * The pass is recorded in three modes:
 *   0. Scan 256-tile chunks from tile_counts[] into tile_offsets[] and write one
 *      chunk sum per workgroup.
 *   1. Scan chunk sums in-place and optionally write the exact total entry
 *      count for diagnostics or overflow tracking.
 *   2. Add the scanned chunk offset to every tile offset in that chunk.
 */

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

const uint kTileScanBlockSize = 256u;
const uint kModeScanTileChunks = 0u;
const uint kModeScanChunkSums = 1u;
const uint kModeAddChunkOffsets = 2u;

layout(push_constant) uniform PC {
    uint mode;
    uint tile_count;
    uint chunk_count;
    uint _padding;
} pc;

layout(set = 3, binding = 0) readonly buffer TileCountBuffer {
    uint tile_counts[];
};

layout(set = 3, binding = 1) buffer TileOffsetBuffer {
    uint tile_offsets[];
};

layout(set = 3, binding = 2) buffer ChunkSumBuffer {
    uint chunk_sums[];
};

layout(set = 3, binding = 3) buffer TotalEntryCountBuffer {
    uint total_entry_count;
};

shared uint shared_values[kTileScanBlockSize];

/**
 * @brief Performs an inclusive scan over shared_values[].
 */
void inclusive_scan_shared() {
    const uint local_index = gl_LocalInvocationID.x;

    for (uint offset = 1u; offset < kTileScanBlockSize; offset <<= 1u) {
        uint addend = 0u;
        if (local_index >= offset) {
            addend = shared_values[local_index - offset];
        }

        barrier();
        shared_values[local_index] += addend;
        barrier();
    }
}

/**
 * @brief Scans one 256-tile chunk and writes exclusive offsets.
 */
void scan_tile_chunk() {
    const uint local_index = gl_LocalInvocationID.x;
    const uint chunk_index = gl_WorkGroupID.x;
    const uint tile_index = chunk_index * kTileScanBlockSize + local_index;
    const bool valid = tile_index < pc.tile_count;

    const uint value = valid ? tile_counts[tile_index] : 0u;
    shared_values[local_index] = value;
    barrier();

    inclusive_scan_shared();

    if (valid) {
        tile_offsets[tile_index] = shared_values[local_index] - value;
    }

    if (local_index == kTileScanBlockSize - 1u && chunk_index < pc.chunk_count) {
        chunk_sums[chunk_index] = shared_values[local_index];
    }
}

/**
 * @brief Scans per-chunk totals and stores the exact total tile-list length.
 *
 * This mode assumes chunk_count <= 256, which covers common desktop render
 * targets with 16x16 tiles. Larger resolutions can extend this with another
 * level of the same scan pattern if needed.
 */
void scan_chunk_sums() {
    const uint local_index = gl_LocalInvocationID.x;
    const bool valid = local_index < pc.chunk_count;

    const uint value = valid ? chunk_sums[local_index] : 0u;
    shared_values[local_index] = value;
    barrier();

    inclusive_scan_shared();

    if (valid) {
        chunk_sums[local_index] = shared_values[local_index] - value;
    }

    if (local_index == kTileScanBlockSize - 1u) {
        total_entry_count = shared_values[local_index];
    }
}

/**
 * @brief Adds scanned chunk offsets to per-tile offsets.
 */
void add_chunk_offsets() {
    const uint local_index = gl_LocalInvocationID.x;
    const uint chunk_index = gl_WorkGroupID.x;
    const uint tile_index = chunk_index * kTileScanBlockSize + local_index;

    if (chunk_index >= pc.chunk_count || tile_index >= pc.tile_count) {
        return;
    }

    tile_offsets[tile_index] += chunk_sums[chunk_index];
}

void main() {
    if (pc.mode == kModeScanTileChunks) {
        scan_tile_chunk();
    } else if (pc.mode == kModeScanChunkSums) {
        scan_chunk_sums();
    } else if (pc.mode == kModeAddChunkOffsets) {
        add_chunk_offsets();
    }
}
