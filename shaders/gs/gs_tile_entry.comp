#version 460

/**
 * @file gs_tile_entry.comp
 * @brief Generates one sortable entry for each visible splat × covered tile.
 *
 * Each invocation processes one compact visible splat from the projection pass.
 * The shader walks that splat's inclusive tile coverage range and appends one
 * entry per tile into bounded entry buffers. Capacity overflow is safe: entries
 * beyond entry_capacity are dropped and counted for diagnostics.
 */

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

/** Projected 2D splat attributes. Matches GSSplatData2D in gaussian_splat_data.h. */
struct GSSplatData2D {
    vec2 center;
    vec2 axis_u;
    vec2 axis_v;
    vec2 _pad0;
    vec3 color;
    float alpha;
    uvec2 tile_min;
    uvec2 tile_max;
};

layout(push_constant) uniform PC {
    uint max_splat_count;
    uint entry_capacity;
    uint tile_count_x;
    uint tile_count_y;
} pc;

layout(set = 3, binding = 0) readonly buffer Splat2DBuffer {
    GSSplatData2D splats_2d[];
};

layout(set = 3, binding = 1) readonly buffer DepthKeyBuffer {
    uint depth_keys[];
};

layout(set = 3, binding = 2) readonly buffer VisibleCounterBuffer {
    uint visible_splat_count;
};

layout(set = 3, binding = 3) buffer EntryCountBuffer {
    uint entry_count;
};

layout(set = 3, binding = 4) buffer EntryStatsBuffer {
    uint entry_requested_count;
    uint entry_written_count;
    uint entry_dropped_count;
    uint invalid_entry_count;
};

layout(set = 3, binding = 5) writeonly buffer EntryDepthKeyBuffer {
    uint entry_depth_keys[];
};

layout(set = 3, binding = 6) writeonly buffer EntryTileIdBuffer {
    uint entry_tile_ids[];
};

layout(set = 3, binding = 7) writeonly buffer EntrySplatIdBuffer {
    uint entry_splat_ids[];
};

layout(set = 3, binding = 8) writeonly buffer EntryIndexBuffer {
    uint entry_indices[];
};

/**
 * @brief Converts a 2D tile coordinate to a linear tile ID.
 */
uint tile_id(uvec2 tile) {
    return tile.y * pc.tile_count_x + tile.x;
}

void main() {
    const uint splat_index = gl_GlobalInvocationID.x;
    const uint active_count = min(pc.max_splat_count, visible_splat_count);
    if (splat_index >= active_count) {
        return;
    }

    if (pc.tile_count_x == 0u || pc.tile_count_y == 0u || pc.entry_capacity == 0u) {
        return;
    }

    const GSSplatData2D splat = splats_2d[splat_index];
    const uvec2 max_tile = uvec2(pc.tile_count_x - 1u, pc.tile_count_y - 1u);
    const uvec2 tile_min = min(splat.tile_min, max_tile);
    const uvec2 tile_max = min(splat.tile_max, max_tile);

    if (tile_min.x > tile_max.x || tile_min.y > tile_max.y) {
        atomicAdd(invalid_entry_count, 1u);
        return;
    }

    const uint depth_key = depth_keys[splat_index];

    for (uint tile_y = tile_min.y; tile_y <= tile_max.y; ++tile_y) {
        for (uint tile_x = tile_min.x; tile_x <= tile_max.x; ++tile_x) {
            const uint requested_index = atomicAdd(entry_requested_count, 1u);
            if (requested_index >= pc.entry_capacity) {
                atomicAdd(entry_dropped_count, 1u);
                continue;
            }

            const uint write_index = atomicAdd(entry_count, 1u);
            atomicAdd(entry_written_count, 1u);
            entry_depth_keys[write_index] = depth_key;
            entry_tile_ids[write_index] = tile_id(uvec2(tile_x, tile_y));
            entry_splat_ids[write_index] = splat_index;
            entry_indices[write_index] = write_index;
        }
    }
}
