#version 460

/**
 * @file gs_tile_scatter.comp
 * @brief Scatters sorted Gaussian splat indices into per-tile lists.
 *
 * Each invocation processes one visible splat in globally sorted order and
 * appends that splat to every tile covered by its projected ellipse. Because
 * invocations traverse the globally sorted splat array, each tile list preserves
 * the front-to-back depth order as long as atomic increments for the same tile
 * observe the issued invocation order within the shader dispatch.
 */

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

/** Projected 2D splat attributes. Matches GSSplatData2D in gaussian_splat_data.h. */
struct GSSplatData2D {
    vec2 center;
    vec2 axis_u;
    vec2 axis_v;
    vec2 _pad0;
    vec3 color;
    float alpha;
    uvec2 tile_min;
    uvec2 tile_max;
};

layout(push_constant) uniform PC {
    uint max_splat_count;
    uint tile_count_x;
    uint tile_count_y;
    uint tile_splat_id_capacity;
} pc;

layout(set = 3, binding = 0) readonly buffer Splat2DBuffer {
    GSSplatData2D splats_2d[];
};

layout(set = 3, binding = 1) readonly buffer SortedSplatIndexBuffer {
    uint sorted_splat_indices[];
};

layout(set = 3, binding = 2) readonly buffer VisibleCounterBuffer {
    uint visible_splat_count;
};

layout(set = 3, binding = 3) readonly buffer TileOffsetBuffer {
    uint tile_offsets[];
};

layout(set = 3, binding = 4) buffer TileCursorBuffer {
    uint tile_cursors[];
};

layout(set = 3, binding = 5) writeonly buffer TileSplatIdBuffer {
    uint tile_splat_ids[];
};

/**
 * @brief Converts a 2D tile coordinate to a linear tile index.
 */
uint tile_index(uvec2 tile) {
    return tile.y * pc.tile_count_x + tile.x;
}

void main() {
    const uint sorted_index = gl_GlobalInvocationID.x;
    const uint active_count = min(pc.max_splat_count, visible_splat_count);
    if (sorted_index >= active_count) {
        return;
    }

    if (pc.tile_count_x == 0u || pc.tile_count_y == 0u || pc.tile_splat_id_capacity == 0u) {
        return;
    }

    const uint splat_index = sorted_splat_indices[sorted_index];
    const GSSplatData2D splat = splats_2d[splat_index];

    const uvec2 max_tile = uvec2(pc.tile_count_x - 1u, pc.tile_count_y - 1u);
    const uvec2 tile_min = min(splat.tile_min, max_tile);
    const uvec2 tile_max = min(splat.tile_max, max_tile);

    if (tile_min.x > tile_max.x || tile_min.y > tile_max.y) {
        return;
    }

    for (uint tile_y = tile_min.y; tile_y <= tile_max.y; ++tile_y) {
        for (uint tile_x = tile_min.x; tile_x <= tile_max.x; ++tile_x) {
            const uint current_tile_index = tile_index(uvec2(tile_x, tile_y));
            const uint local_offset = atomicAdd(tile_cursors[current_tile_index], 1u);
            const uint global_offset = tile_offsets[current_tile_index] + local_offset;

            if (global_offset < pc.tile_splat_id_capacity) {
                tile_splat_ids[global_offset] = splat_index;
            }
        }
    }
}
